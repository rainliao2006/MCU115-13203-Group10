<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/title_select_side_dishes"
        android:textSize="18sp"
        android:textStyle="bold"
        android:layout_marginBottom="16dp"/>

    <CheckBox
        android:id="@+id/cbFries"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/side_fries"
        android:textSize="16sp"
        android:layout_marginBottom="8dp"/>

    <CheckBox
        android:id="@+id/cbSalad"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/side_salad"
        android:textSize="16sp"
        android:layout_marginBottom="8dp"/>

    <CheckBox
        android:id="@+id/cbCornCup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/side_corn_cup"
        android:textSize="16sp"
        android:layout_marginBottom="24dp"/>

    <Button
        android:id="@+id/btnDoneSides"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="#673AB7"
        android:text="@string/btn_done" />
</LinearLayout>
